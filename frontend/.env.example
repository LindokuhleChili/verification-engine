# Copy to .env.local for local development (`npm run dev` picks it up automatically).
# In deployment, Amplify Hosting sets these as build-time environment variables
# directly from the CDK stack's outputs - see infra/VerificationEngine.Infra/
# VerificationEngineStack.Frontend.cs - so this file only matters for `npm run dev`.

# From the CDK stack's "ApiUrl" output.
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com

# From the CDK stack's "UserPoolId" / "UserPoolClientId" outputs.
VITE_COGNITO_USER_POOL_ID=eu-west-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

VITE_AWS_REGION=eu-west-1
