<Project>
  <PropertyGroup>
    <!-- Lambda's managed .NET runtime is 8; every project targets it so the same
         assemblies that build locally are the ones that run in the cloud. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Only .NET 10 is installed on the dev machine; net8.0 test assemblies
         roll forward onto it rather than requiring a second runtime install. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
</Project>
