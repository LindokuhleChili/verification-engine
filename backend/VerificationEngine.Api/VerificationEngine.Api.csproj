<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AWSProjectType>Lambda</AWSProjectType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="2.2.1" />
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.3" />
    <!-- QuestPDF (used by VerificationEngine.Services for document generation) renders
         text through SkiaSharp. Lambda's Amazon Linux image doesn't ship fontconfig/
         freetype, so the statically-linked "NoDependencies" native asset is required -
         without it, PDF generation throws a DllNotFoundException at cold start on
         Lambda even though it works fine on a dev machine. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../VerificationEngine.Services/VerificationEngine.Services.csproj" />
  </ItemGroup>
</Project>
